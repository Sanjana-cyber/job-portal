{
  "info": {
    "_postman_id": "8b5f3d1e-84b2-4d2c-882d-12845ac31db2",
    "name": "MERN Job Portal Authentication API",
    "description": "Production-quality role-based authentication endpoints for Job Portal. Includes rate limiting, secure HTTP-only cookies, JWT, Google OAuth, and email verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"jobseeker@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"jobseeker\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Register a new Job Seeker or Recruiter. Admin registration is blocked on this endpoint. Automatically sends verification email."
          },
          "response": []
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jobseeker@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticate user and set HTTP-only cookie containing JWT."
          },
          "response": []
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Fetch user details of current authenticated session using token cookie or Authorization header."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jobseeker@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Generate a unique hashed password reset token and send custom email link with Nodemailer. Returns secure generic response."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"your_received_reset_token_here\",\n  \"password\": \"NewSecurePassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Verify reset token and update password. Automatically logs user in."
          },
          "response": []
        },
        {
          "name": "Google OAuth Sign-In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"google_jwt_credential_token_here\",\n  \"role\": \"jobseeker\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Sign in or register using Google credentials. Securely decodes and validates Google JWT payload."
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/verify-email/your_email_verification_token_here",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-email",
                "your_email_verification_token_here"
              ]
            },
            "description": "Verify email address using the token received in email."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Clear HTTP-only JWT token cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Simple health-check endpoint for system uptime."
      },
      "response": []
    }
  ],
