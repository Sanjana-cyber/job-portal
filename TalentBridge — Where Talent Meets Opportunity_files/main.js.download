    args: [{ selector: "app-auth-modal", standalone: true, imports: [CommonModule2, ReactiveFormsModule, FormsModule], template: `<div class="modal-overlay" *ngIf="state.open" (click)="onBackdropClick($event)">
  <div class="modal-container animate-scale-in" (click)="$event.stopPropagation()">
    <button class="modal-close" (click)="close()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Header -->
    <div class="modal-header">
      <h2 class="modal-title">
        {{ state.tab === 'login' ? (showForgot ? 'Reset Password' : 'Welcome back') : 'Create an account' }}
      </h2>
      <p class="modal-subtitle" *ngIf="state.tab === 'login' && !showForgot">Sign in to your TalentBridge account</p>
      <p class="modal-subtitle" *ngIf="state.tab === 'login' && showForgot">We'll help you get back in</p>
      <p class="modal-subtitle" *ngIf="state.tab === 'register'">Join TalentBridge today</p>
    </div>

    <!-- Tab Switcher (hide if forgot password view is active) -->
    <div class="tab-switcher" *ngIf="!showForgot">
      <div class="tab-indicator" [style.transform]="tabTranslate"></div>
      <button class="tab-btn" [class.active]="state.tab === 'login'" (click)="switchTab('login')">Login</button>
      <button class="tab-btn" [class.active]="state.tab === 'register'" (click)="switchTab('register')">Register</button>
    </div>

    <!-- \u2550\u2550\u2550 LOGIN TAB \u2550\u2550\u2550 -->
    <div class="auth-view" [hidden]="state.tab !== 'login'">
      
      <!-- Forgot Password View -->
      <ng-container *ngIf="showForgot; else loginFormTpl">
        <div class="auth-form-container">
          <div class="error-banner" *ngIf="forgotError">
            <span>{{ forgotError }}</span>
          </div>
          <div class="success-banner" *ngIf="forgotMessage" style="color:var(--success-500); margin-bottom:1rem; font-size:14px;">
            <span>{{ forgotMessage }}</span>
          </div>

          <div class="input-group" style="margin-bottom:1rem;">
            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <input type="email" class="auth-input" placeholder="Enter your email address" [(ngModel)]="forgotEmail">
          </div>
          
          <button class="btn-primary" style="width:100%; margin-bottom:0.5rem;" (click)="submitForgotPassword()" [disabled]="forgotLoading">
            <span *ngIf="forgotLoading" class="spinner"></span>
            {{ forgotLoading ? 'Sending\u2026' : 'Send Reset Link' }}
          </button>
          <button class="btn-ghost" style="width:100%; justify-content:center;" (click)="hideForgotView()">
            \u2190 Back to login
          </button>
        </div>
      </ng-container>

      <ng-template #loginFormTpl>
        <div class="error-banner" *ngIf="loginError">
          <span>{{ loginError }}</span>
        </div>

        <form [formGroup]="loginForm" (ngSubmit)="onLoginSubmit()" class="auth-form">
          <div class="input-group">
            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <input formControlName="email" type="email" class="auth-input" placeholder="Email address">
          </div>
          <div class="input-group">
            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input formControlName="password" [type]="showLoginPassword ? 'text' : 'password'" class="auth-input" placeholder="Password">
            <button type="button" class="password-toggle" (click)="toggleLoginPwd()">
              <svg *ngIf="!showLoginPassword" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg *ngIf="showLoginPassword" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          
          <button type="button" class="forgot-link" (click)="showForgotView()">Forgot password?</button>
          
          <button type="submit" class="btn-primary" style="width:100%" [disabled]="loginForm.invalid || loginLoading">
            <span *ngIf="loginLoading" class="spinner"></span>
            {{ loginLoading ? 'Signing in\u2026' : 'Sign In' }}
          </button>
        </form>

        <div class="divider"><span>or</span></div>
        <div id="modal-google-login-btn"></div>
      </ng-template>
    </div>

    <!-- \u2550\u2550\u2550 REGISTER TAB \u2550\u2550\u2550 -->
    <div class="auth-view" [hidden]="state.tab !== 'register'">
      <div class="error-banner" *ngIf="registerError">
        <span>{{ registerError }}</span>
      </div>

      <form [formGroup]="registerForm" (ngSubmit)="onRegisterSubmit()" class="auth-form">
        <!-- Role Selector -->
        <div class="role-selector">
          <label class="role-option" [class.active]="registerForm.get('role')?.value === 'jobseeker'">
            <input type="radio" formControlName="role" value="jobseeker">
            Job Seeker
          </label>
          <label class="role-option" [class.active]="registerForm.get('role')?.value === 'recruiter'">
            <input type="radio" formControlName="role" value="recruiter">
            Recruiter
          </label>
        </div>

        <div class="input-group">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <input formControlName="name" type="text" class="auth-input" [class.input-error]="hasRegError('name', 'required')" placeholder="Full name">
        </div>

        <div class="input-group">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <input formControlName="email" type="email" class="auth-input" [class.input-error]="hasRegError('email', 'required') || hasRegError('email', 'email')" placeholder="Email address">
        </div>

        <ng-container *ngIf="isRecruiter">
          <div class="input-group">
            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <input formControlName="companyName" type="text" class="auth-input" [class.input-error]="hasRegError('companyName', 'required')" placeholder="Company name">
          </div>
          <div class="input-group">
            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <input formControlName="companyWebsite" type="url" class="auth-input" placeholder="Company website (optional)">
          </div>
        </ng-container>

        <div class="input-group">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input formControlName="password" [type]="showRegPwd ? 'text' : 'password'" class="auth-input" [class.input-error]="hasRegError('password', 'required') || hasRegError('password', 'minlength')" placeholder="Password (min 6 chars)">
          <button type="button" class="password-toggle" (click)="toggleRegPwd()">
             <svg *ngIf="!showRegPwd" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
             <svg *ngIf="showRegPwd" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
          </button>
        </div>

        <div class="input-group">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input formControlName="confirmPassword" [type]="showRegConfirmPwd ? 'text' : 'password'" class="auth-input" [class.input-error]="hasRegError('confirmPassword', 'required') || registerForm.get('confirmPassword')?.hasError('passwordMismatch')" placeholder="Confirm password">
        </div>

        <button type="submit" class="btn-primary" style="width:100%" [disabled]="registerForm.invalid || registerLoading">
          <span *ngIf="registerLoading" class="spinner"></span>
          {{ registerLoading ? 'Creating account\u2026' : 'Create Account' }}
        </button>
      </form>

      <div class="divider"><span>or</span></div>
      <div id="modal-google-register-btn"></div>
    </div>

  </div>
</div>
`, styles: ["/* src/app/shared/components/auth-modal/auth-modal.component.css */\n.role-selector {\n  display: flex;\n  background: var(--cream-200);\n  border-radius: var(--radius-md);\n  padding: 4px;\n  margin-bottom: var(--sp-2);\n}\n.role-option {\n  flex: 1;\n  text-align: center;\n  padding: 8px 12px;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--text-secondary);\n  border-radius: calc(var(--radius-md) - 2px);\n  cursor: pointer;\n  transition: all var(--ease-fast);\n}\n.role-option input[type=radio] {\n  display: none;\n}\n.role-option.active {\n  background: var(--bg-surface);\n  color: var(--text-primary);\n  box-shadow: var(--shadow-sm);\n}\n.spinner {\n  width: 14px;\n  height: 14px;\n  border: 2px solid rgba(255, 255, 255, 0.3);\n  border-top-color: #fff;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n  display: inline-block;\n  vertical-align: middle;\n}\n/*# sourceMappingURL=auth-modal.component.css.map */\n"] }]
