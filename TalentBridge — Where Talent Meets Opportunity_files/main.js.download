    this.loginError = "";
    this.registerError = "";
    this.loginLoading = false;
    this.registerLoading = false;
    this.showForgot = false;
    this.showLoginPassword = false;
    this.showRegPwd = false;
    this.showRegConfirmPwd = false;
  }
